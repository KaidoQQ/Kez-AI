/* Базовая тема приложения (Темно-синий + Кремовый акцент, глубокие темные тона) */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0B1120, stop:1 #172033); /* Глубокий темно-синий градиент */
}

/* Боковая панель (Sidebar) */
#sidebar {
    background-color: rgba(7, 11, 20, 200); /* Почти черный/очень темно-синий */
    border-right: 1px solid rgba(240, 234, 218, 50); /* Легкий кремовый контур */
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
}
#sidebar QLabel {
    color: #F0EADA; /* Кремовый текст */
    font-weight: bold;
    font-size: 16px;
    padding: 10px;
}

/* Зона чата (Scroll Area) */
#chat_area {
    background-color: transparent;
    border: none;
}
QWidget#chat_content {
    background-color: transparent;
}

/* Стилизация скроллбара */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(240, 234, 218, 40);
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(240, 234, 218, 100);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}


/* Поле ввода */
#input_field {
    background-color: rgba(23, 32, 51, 180);
    color: #F0EADA; /* Кремовый текст */
    border: 2px solid rgba(240, 234, 218, 50); /* Тусклая кремовая рамка */
    border-radius: 22px; 
    padding: 10px 15px;
    font-size: 14px;
}
#input_field:focus {
    border: 2px solid rgba(240, 234, 218, 150); /* Яркая кремовая рамка при фокусе */
    background-color: rgba(23, 32, 51, 220);
}

/* Кнопки */
#send_btn, #action_btn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(29, 43, 83, 220), stop:1 rgba(17, 26, 51, 220)); /* Выделяющийся темно-синий градиент */
    color: #F0EADA; /* Кремовый текст */
    border: none;
    border-radius: 22px;
    padding: 0px; /* Убрали отступы для квадратных кнопок */
    font-weight: bold;
    font-size: 14px;
    border: 1px solid rgba(240, 234, 218, 30);
}
#send_btn:hover, #action_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(39, 58, 113, 255), stop:1 rgba(23, 35, 70, 255));
    border: 1px solid rgba(240, 234, 218, 80);
}

#menu_btn {
    background-color: rgba(0, 0, 0, 0);
    color: #F0EADA;
    border: none;
    border-radius: 20px;
    font-size: 20px;
    padding: 0px;
}
#menu_btn:hover {
    background-color: rgba(240, 234, 218, 20); /* Легкая кремовая подсветка */
}

/* Сообщения (Баблы) */
.QLabel[msg_type="user"], QTextBrowser[msg_type="user"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(29, 43, 83, 230), stop:1 rgba(17, 26, 51, 230));
    color: #F0EADA; /* Кремовый текст */
    border: 1px solid rgba(240, 234, 218, 20);
    border-radius: 18px;
    padding: 10px 16px;
    margin: 5px;
    font-size: 14px;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}
.QLabel[msg_type="ai"], QTextBrowser[msg_type="ai"] {
    background-color: rgba(30, 41, 59, 200); /* Приглушенный серо-синий */
    color: #E2DFD2; /* Чуть более тусклый кремовый */
    border: 1px solid rgba(240, 234, 218, 10);
    border-radius: 18px;
    padding: 10px 16px;
    margin: 5px;
    font-size: 14px;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}
.QLabel[msg_type="typing"] {
    background-color: rgba(30, 41, 59, 140);
    color: #A0AEC0;
    border: 1px dashed rgba(240, 234, 218, 20);
    border-radius: 16px;
    padding: 8px 16px;
    margin: 5px;
    font-size: 13px;
    font-style: italic;
}

/* Стили для новых кнопок */
#settings_btn, #pet_btn {
    background-color: rgba(0, 0, 0, 0);
    color: #F0EADA;
    border: none;
    border-radius: 20px;
    font-size: 20px;
    padding: 0px;
}
#settings_btn:hover, #pet_btn:hover {
    background-color: rgba(240, 234, 218, 20);
}

#new_chat_btn {
    background-color: transparent;
    color: #F0EADA;
    border: 1px solid rgba(240, 234, 218, 50);
    border-radius: 12px;
    padding: 5px 10px;
    font-size: 12px;
    margin-bottom: 10px;
}
#new_chat_btn:hover {
    background-color: rgba(240, 234, 218, 20);
}

#send_btn {
    padding: 10px 20px; /* Возвращаем отступы для кнопки Send */
}

/* Список истории чатов в сайдбаре */
QListWidget#chat_list_widget {
    background-color: transparent;
    border: none;
    outline: none;
    color: #F0EADA;
    font-size: 13px;
}

QListWidget#chat_list_widget::item {
    background-color: rgba(23, 32, 51, 100);
    color: #E2DFD2;
    border: 1px solid rgba(240, 234, 218, 20);
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 6px;
}

QListWidget#chat_list_widget::item:hover {
    background-color: rgba(39, 58, 113, 160);
    border: 1px solid rgba(240, 234, 218, 60);
    color: #FFFFFF;
}

QListWidget#chat_list_widget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(39, 58, 113, 230), stop:1 rgba(23, 35, 70, 230));
    border: 1px solid rgba(240, 234, 218, 120);
    color: #F0EADA;
    font-weight: bold;
}
