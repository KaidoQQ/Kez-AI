/* Native Qt design inspired by assistant-ui's restrained chat layout. */
QWidget { font-family: "Segoe UI", "DejaVu Sans", sans-serif; font-size: 14px; color: #202024; }
QMainWindow, QDialog, #workspace { background: #ffffff; }
QLabel { background: transparent; }
QToolTip { background: #f4f4f5; color: #202024; border: 1px solid #dcdce2; padding: 6px; }
#sidebar { background: #f7f7f8; border-right: 1px solid #dcdce2; }
#brand { font-size: 23px; font-weight: 700; padding: 8px 4px 20px; }
#section_label, #muted, #file_dir_label, #composer_hint { color: #686873; font-size: 12px; }
#section_label { padding: 18px 6px 6px; }
#header_title { font-size: 16px; font-weight: 600; }
#model_badge { color: #686873; font-size: 12px; padding: 4px 12px; }
QPushButton { background: #f4f4f5; border: 1px solid #dcdce2; border-radius: 8px; padding: 8px 12px; }
QPushButton:hover { background: #eaeaee; }
QPushButton:pressed { background: #e4e4ec; }
QPushButton:focus { border: 1px solid #7054c4; }
QPushButton:disabled { color: #686873; background: #f7f7f8; }
#new_chat_btn { text-align: left; font-weight: 600; padding: 11px 14px; }
#action_btn, #menu_btn, #settings_btn, #pet_btn, #copy_btn { background: transparent; border: 1px solid transparent; padding: 0; }
#action_btn:hover, #menu_btn:hover, #settings_btn:hover, #pet_btn:hover, #copy_btn:hover { background: #eaeaee; }
#action_btn:focus, #menu_btn:focus, #settings_btn:focus, #pet_btn:focus, #copy_btn:focus { border: 1px solid #7054c4; }
#send_btn, #language_continue { background: #202024; color: #ffffff; font-weight: 600; border: none; padding: 8px 16px; }
#send_btn:hover, #language_continue:hover { background: #686873; }
#send_btn:disabled { background: #eaeaee; color: #686873; }
#meet_kez_btn { color: #7054c4; background: #f4f4f5; border: 1px solid #dcdce2; }
QLineEdit, QComboBox, QSpinBox { background: #f4f4f5; border: 1px solid #dcdce2; border-radius: 8px; padding: 9px 10px; selection-background-color: #7054c4; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #7054c4; }
QComboBox QAbstractItemView { background: #f4f4f5; color: #202024; selection-background-color: #e4e4ec; }
#search_field { background: transparent; font-size: 12px; }
QListWidget { background: #f4f4f5; border: 1px solid #dcdce2; border-radius: 8px; outline: none; }
#chat_list_widget { background: transparent; border: none; }
QListWidget::item { padding: 11px 10px; border-radius: 7px; margin: 2px 0; }
QListWidget::item:hover { background: #eaeaee; }
QListWidget::item:selected { background: #e4e4ec; color: #202024; }
#chat_area, #chat_content { background: transparent; border: none; }
QTextBrowser { border: none; background: transparent; selection-background-color: #7054c4; selection-color: white; }
QTextBrowser[msg_type="user"] { background: #f4f4f5; border-radius: 16px; padding: 12px 16px; font-size: 15px; }
QTextBrowser[msg_type="ai"] { background: transparent; padding: 8px 0; font-size: 15px; }
QLabel[msg_type="typing"] { color: #686873; padding: 12px; }
#composer { background: #f4f4f5; border: 1px solid #dcdce2; border-radius: 18px; }
#input_field { background: transparent; border: none; padding: 6px; font-size: 15px; selection-background-color: #7054c4; }
#welcome_mark { font-size: 32px; color: #7054c4; }
#welcome_title { font-size: 28px; font-weight: 600; }
#welcome_subtitle { color: #686873; font-size: 14px; }
#suggestion { text-align: left; background: #f4f4f5; padding: 16px; border-radius: 12px; }
#suggestion:hover { border-color: #7054c4; }
#chat_file_card, #chat_image_label, #pet_card { background: #f4f4f5; border: 1px solid #dcdce2; border-radius: 12px; }
#pet_bubble { background: #f4f4f5; color: #202024; border: 1px solid #dcdce2; border-radius: 12px; padding: 10px; }
#pet_control { padding: 0; }
QMenu { background: #f4f4f5; border: 1px solid #dcdce2; padding: 6px; }
QMenu::item { padding: 8px 24px; }
QMenu::item:selected { background: #e4e4ec; }
QTabWidget::pane { border: 1px solid #dcdce2; border-radius: 10px; background: #ffffff; }
#settings_tab { background: transparent; }
QTabBar::tab { background: transparent; color: #686873; padding: 12px 20px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #202024; border-bottom-color: #7054c4; }
QCheckBox { spacing: 10px; padding: 5px 0; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #686873; border-radius: 4px; background: #f4f4f5; }
QCheckBox::indicator:checked { background: #7054c4; border-color: #7054c4; }
#language_heading { font-size: 24px; font-weight: 600; }
#language_subtitle { color: #686873; }
#language_option { padding: 18px; font-size: 16px; }
#language_option:checked { border-color: #7054c4; background: #e4e4ec; }
QScrollBar:vertical { background: transparent; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: #dcdce2; min-height: 30px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: #686873; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
